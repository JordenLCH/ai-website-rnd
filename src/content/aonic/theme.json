{
  "name": "aonic",
  "tokens": {
    "--color-bg": "#F3F4F6",
    "--color-surface": "#FFFFFF",
    "--color-ink": "#0B132B",
    "--color-muted": "#5A6478",
    "--color-line": "rgba(11,19,43,0.16)",
    "--color-accent": "#F26522",
    "--color-on-accent": "#2B1200",
    "--color-inverse-bg": "#0B132B",
    "--color-inverse-ink": "#EEF1F6",
    "--color-inverse-muted": "#94A0B8",
    "--color-inverse-line": "rgba(238,241,246,0.18)",
    "--font-display": "'Space Grotesk', system-ui, sans-serif",
    "--font-body": "'IBM Plex Sans', system-ui, sans-serif",
    "--font-eyebrow": "'IBM Plex Mono', ui-monospace, monospace",
    "--font-numeral": "'IBM Plex Mono', ui-monospace, monospace",
    "--display-size": "clamp(2.4rem, 6.4cqi, 4.6rem)",
    "--display-weight": "700",
    "--display-tracking": "-0.03em",
    "--display-leading": "1.02",
    "--heading-size": "clamp(1.7rem, 3.4cqi, 2.6rem)",
    "--eyebrow-transform": "uppercase",
    "--eyebrow-tracking": "0.2em",
    "--eyebrow-size": "0.72rem",
    "--body-size": "1rem",
    "--lede-size": "1.06rem",
    "--body-leading": "1.55",
    "--radius": "2px",
    "--radius-img": "2px",
    "--border": "1px",
    "--pad-y": "clamp(56px, 8cqi, 104px)",
    "--gap": "clamp(20px, 2.4cqi, 28px)",
    "--maxw": "1180px",
    "--shadow": "none",
    "--btn-radius": "2px",
    "--btn-pad": "0.85rem 1.5rem",
    "--btn-weight": "600",
    "--img-filter": "saturate(1.05) contrast(1.05)",
    "--hero-min": "78cqi",
    "--overlay": "linear-gradient(75deg, rgba(11,19,43,0.94) 8%, rgba(11,19,43,0.62) 52%, rgba(11,19,43,0.25) 100%)"
