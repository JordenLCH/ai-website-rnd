          "type": "MediaText",
          "variant": "mediatext/lead",
          "props": {
            "eyebrow": "Mesh",
            "title": "Polyelastomer, recyclable, tensioned to spec",
            "body": [
              "Our polyelastomer mesh is 100% recyclable and tensioned against a moulded frame rather than a stretched panel, so seat pressure stays even as the material ages.",
              "Where a floor needs higher air movement we specify high-tensile polyester instead \u2014 the same frame accepts both."
            ],
            "image": "/img/merryfair/24-mesh-detail.webp",
            "imageAlt": "Close detail of chair mesh"
          }
        },
        {
          "type": "Features",
          "variant": "features/values",
          "props": {
            "eyebrow": "Engineering pillars",
            "title": "What we test for",
            "items": [
              {
                "title": "Synchronised tilt",
                "body": "Backrest and seat rotate on a fixed ratio so the sightline to the desk holds through the full recline range."
              },
              {
                "title": "Auto weight sensing",
                "body": "Tension adapts to occupant mass without a dial, which matters on hot-desked floors where nobody adjusts anything."
              },
              {
                "title": "Multi-axis lumbar",
                "body": "Height and depth adjust independently, so support tracks the lordotic curve rather than a single fixed bump."
              }
            ]
          }
        },
