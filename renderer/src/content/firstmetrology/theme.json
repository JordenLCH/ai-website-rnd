{
  "name": "firstmetrology",
  "tokens": {
    "--color-bg": "#FFFFFF",
    "--color-surface": "#F1F4F7",
    "--color-ink": "#111827",
    "--color-muted": "#7F8C8D",
    "--color-line": "rgba(17,24,39,0.14)",
    "--color-accent": "#0066CC",
    "--color-on-accent": "#FFFFFF",
    "--color-inverse-bg": "#111827",
    "--color-inverse-ink": "#F5F7FA",
    "--color-inverse-muted": "#9AA5B1",
    "--color-inverse-line": "rgba(245,247,250,0.16)",
    "--font-display": "'Archivo Narrow', system-ui, sans-serif",
    "--font-body": "'Public Sans', system-ui, sans-serif",
    "--font-eyebrow": "'JetBrains Mono', ui-monospace, monospace",
    "--font-numeral": "'JetBrains Mono', ui-monospace, monospace",
    "--display-size": "clamp(2.2rem, 6cqi, 4.2rem)",
    "--display-weight": "700",
    "--display-tracking": "-0.01em",
    "--display-leading": "1.05",
    "--heading-size": "clamp(1.6rem, 3.2cqi, 2.4rem)",
    "--eyebrow-transform": "uppercase",
    "--eyebrow-tracking": "0.18em",
    "--eyebrow-size": "0.72rem",
    "--body-size": "1rem",
    "--lede-size": "1.08rem",
    "--body-leading": "1.6",
    "--radius": "4px",
    "--radius-img": "4px",
    "--border": "1px",
    "--pad-y": "clamp(60px, 8cqi, 112px)",
    "--gap": "clamp(20px, 2.6cqi, 32px)",
    "--maxw": "1200px",
    "--shadow": "0 1px 0 rgba(17,24,39,0.06)",
    "--btn-radius": "4px",
    "--btn-pad": "0.9rem 1.6rem",
    "--btn-weight": "600",
    "--img-filter": "contrast(1.05) saturate(0.92)",
    "--hero-min": "64cqi",
    "--overlay": "linear-gradient(160deg, rgba(17,24,39,0.92) 0%, rgba(17,24,39,0.55) 55%, rgba(17,24,39,0.18) 100%)"
  },
  "sectionStyles": {
    "nav/main": { "layout": "split-rail", "tone": "default" },
    "hero/home": { "layout": "stacked-title", "tone": "inverse" },
    "hero/page": { "layout": "overlay-fullbleed", "tone": "inverse" },
    "logos/certs": { "layout": "hairline-row", "tone": "default" },
    "stats/proof": { "layout": "boxed-grid", "tone": "default" },
    "features/range": { "layout": "cards-soft", "tone": "default" },
    "mediatext/lead": { "layout": "image-left", "tone": "surface" },
    "mediatext/alt": { "layout": "image-right", "tone": "default" },
    "cta/main": { "layout": "hard-panel", "tone": "accent" },
    "cta/soft": { "layout": "soft-band", "tone": "inverse" },
    "footer/main": { "layout": "columns", "tone": "inverse" },
    "crumbs/page": { "layout": "boxed", "tone": "default" },
    "catalog/range": { "layout": "cards-grid", "tone": "default" },
    "spec/product": { "layout": "two-col-groups", "tone": "surface" },
    "steps/process": { "layout": "numbered-rail", "tone": "surface" },
    "rich/intro": { "layout": "two-col-prose", "tone": "default" },
    "locations/main": { "layout": "split-panel", "tone": "surface" },
    "form/main": { "layout": "split-form", "tone": "default" }
  }
}
