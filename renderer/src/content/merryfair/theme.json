    },
    "free/proof": {
      "layout": "free",
      "tone": "default"
    },
    "free/range": {
      "layout": "free",
      "tone": "surface"
    },
    "free/story": {
      "layout": "free",
      "tone": "default"
    },
    "free/spec": {
      "layout": "free",
      "tone": "surface"
    },
    "free/quote": {
      "layout": "free",
      "tone": "accent"
    },
    "free/process": {
      "layout": "free",
      "tone": "default"
    },
    "free/media": {
      "layout": "free",
      "tone": "inverse"
    },
    "free/contact": {
      "layout": "free",
      "tone": "surface"
    },
    "free/cta": {
      "layout": "free",
      "tone": "inverse"
    },
    "free/footer": {
      "layout": "free",
