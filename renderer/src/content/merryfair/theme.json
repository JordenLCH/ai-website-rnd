    },
    "cta/soft": {
      "layout": "centered-poster",
      "tone": "surface"
    },
    "footer/main": {
      "layout": "centered-minimal",
      "tone": "inverse"
    },
    "crumbs/page": {
      "layout": "inline",
      "tone": "surface"
    },
    "promo/strip": {
      "layout": "split-strip",
      "tone": "accent"
    },
    "catalog/range": {
      "layout": "cards-grid",
      "tone": "default"
