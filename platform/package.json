{
  "name": "@blackdash/platform",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./build": "./src/build.ts",
    "./seo": "./src/seo.ts",
    "./assets": "./src/assets.ts"
  },
  "type": "module",
  "scripts": {
    "build": "node --import tsx src/cli.ts",
    "smoke": "node --import tsx src/smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "bench": "node --import tsx tools/bench.ts",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@blackdash/renderer": "file:../renderer",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "schema-dts": "^2.0.0",
    "tsx": "^4.19.2"
  }
}
