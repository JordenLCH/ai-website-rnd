node_modules/
dist/
dist-bundles/
store/
.vite/
.catalog-token
.DS_Store

# client source material — briefs, copy and licensed imagery, not platform code
website_info/

# demo imagery for the sample content: duplicated from website_info, restored with
# scripts/restore-demo-assets.sh. Keeping it out means the renderer package ships
# the catalog, not several megabytes of a client's photography.
renderer/public/img/

# scratch and local reference
dev/

# per-repo agent claim board, never committed
workers.md
better_AI_demo

# written by setup-mcp.sh, holds a live catalog token.
# Anchored to the root on purpose: a bare `.mcp.json` also matched `plugin/.mcp.json`, which is not
# a local artifact at all — it is the config that SHIPS inside the plugin, and it holds no secret
# (`x-api-key: ${CATALOG_TOKEN}`, an env reference). Ignoring it meant a fresh clone had no copy, so
# package-plugin.sh would zip a plugin with no MCP config and the catalog would silently never
# connect for the creator who installed it.
/.mcp.json

# throwaway chrome screenshots from a review session — never committed
preview-shots/
docs/images

# POC shared key, written at run time
poc/mcp-app/.poc-token

# built plugin archives — rebuild with ./package-plugin.sh
dist-plugin/
