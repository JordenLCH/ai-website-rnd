node_modules/
dist/
dist-bundles/
store/
.vite/
.catalog-token
.DS_Store

# client source material — briefs, copy and licensed imagery, not platform code
website_info/

# demo imagery for the sample content: duplicated from website_info, restored with
# scripts/restore-demo-assets.sh. Keeping it out means the renderer package ships
# the catalog, not several megabytes of a client's photography.
renderer/public/img/

# scratch and local reference
dev/

# per-repo agent claim board, never committed
workers.md
better_AI_demo

# written by setup-mcp.sh, holds a live catalog token
.mcp.json

# throwaway chrome screenshots from a review session — never committed
preview-shots/
docs/images

# the fleet — generated client bundles, one folder per site. Local work product,
# not platform code, and the source material it derives from is ignored too.
# Everything in here is served to any token holder by fleet_siblings, so it holds live client
# sites only — test bundles live in mcp/fixtures/, which is ignored for the same reason.
content/
mcp/fixtures/*/

# POC shared key, written at run time
poc/mcp-app/.poc-token
create-webpage.zip

# built plugin archives — rebuild with scripts/package-plugin.sh
dist-plugin/

# local hosting target for the catalog server, holds a live BUNDLE_KEY
mcp/.env.local
